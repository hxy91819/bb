#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
用法：scripts/fork-package [--base <tag>] [--resume <sha>] [--test-filter <turbo filter>]... [--verify-only] [--no-release] [--no-build]

一条命令完成聚合打包：聚合 → 在 .worktrees/aggregate-deploy-<sha> 里安装、typecheck、测试 →
提升 main → 运行时构建与原生模块检查 → 打 fork-v* tag 并推送 → 清理被取代的候选 →
打印 cutover 提示。全程串行，每一步都在单个 run-resource-isolated scope 里执行；任何一步失败就停在原地。
聚合 SHA 由输入决定，分支没变时重跑会复用同一个 aggregate-deploy-<sha> 检出及其依赖。
清理只删除干净、既不是本次结果、也不是服务运行目录或上一次 main 的 aggregate-deploy-* 检出。

--test-filter  传给 turbo run test 的 --filter，可重复；默认 "[<上一次 main>]"，
               即只测相对上次聚合有文件改动的包。
--resume       从该 SHA 的已记录检出接续；保留原基线、比较起点和测试范围。
--verify-only  测试通过后停止：不提升、不构建、不打 tag，保留 .worktrees/aggregate-deploy-<sha> 供检查。
--no-release   不打发布 tag。
--no-build     提升后停止，不做运行时构建。
USAGE
}

base_override=""
release=1
build=1
verify_only=0
resume=""
test_filters=()
filters_explicit=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) base_override="${2:?--base 需要 tag}"; shift 2 ;;
    --resume) resume="${2:?--resume 需要 SHA}"; shift 2 ;;
    --test-filter) test_filters+=("${2:?--test-filter 需要值}"); filters_explicit=1; shift 2 ;;
    --verify-only) verify_only=1; shift ;;
    --no-release) release=0; shift ;;
    --no-build) build=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [ -n "$resume" ]; then
  [[ "$resume" =~ ^[a-f0-9]{40}$ ]] && [ -z "$base_override" ] && [ "${#test_filters[@]}" = 0 ] || { usage >&2; exit 2; }
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --path-format=absolute --git-common-dir)"
root="$(dirname "$root")"
cd "$root"

if [ "$verify_only" = 0 ]; then
  [ "$(git branch --show-current)" = main ] && [ -z "$(git status --porcelain)" ] || {
    echo "提升需要干净的 main 根目录；请保留原现场并使用独立干净 clone，或先 --verify-only" >&2
    exit 1
  }
fi

step() { printf '\n==> %s\n' "$*"; }
config_value() { node -p "require('$config').service.$1"; }
state_tool="$here/fork-package-state.mjs"
state_root="$(git rev-parse --path-format=absolute --git-common-dir)/fork-package"
run_stage() {
  [ "$(git -C "$wt" rev-parse HEAD)" = "$result" ] && [ -z "$(git -C "$wt" status --porcelain)" ] || { echo "聚合检出已改变，停止接续" >&2; exit 1; }
  node "$state_tool" run "$state" "$1" "$wt" "${@:2}"
}

if [ -z "$resume" ]; then
  previous="$(git ls-remote fork refs/heads/main | cut -f1)"
  [ -n "$previous" ] || { echo "fork 上没有 main" >&2; exit 1; }

  if [ -n "$base_override" ]; then
    base="$base_override"
  else
    list_ref=refs/heads/fork-tooling
    git rev-parse --verify --quiet "$list_ref" >/dev/null || list_ref=refs/remotes/fork/fork-tooling
    base="$(git show "$list_ref:.fork/branches" | awk '$1 == "base" { print $2 }')"
  fi

  step "安全基线"
  "$here/fork-base" --base "$base"

  step "聚合"
  "$here/fork-aggregate" --base "$base"
  result="$(git rev-parse --verify refs/heads/aggregate/next)"
  short="$(git rev-parse --short "$result")"
  wt="$root/.worktrees/aggregate-deploy-$short"
  step "工作区 $wt"
  if [ -d "$wt" ]; then
    [ "$(git -C "$wt" rev-parse HEAD)" = "$result" ] || { echo "$wt 已存在但不是 $result" >&2; exit 1; }
    [ -z "$(git -C "$wt" status --porcelain --untracked-files=no)" ] || { echo "$wt 有未提交改动" >&2; exit 1; }
    git worktree remove "$root/.worktrees/aggregate-next"
  else
    git worktree move "$root/.worktrees/aggregate-next" "$wt"
    git -C "$wt" checkout --quiet --detach "$result"
  fi
  if [ "${#test_filters[@]}" -eq 0 ]; then
    test_filters=("[$previous]")
  fi
  state="$state_root/$result.json"
  node "$state_tool" init "$state" "$result" "$base" "$previous" "$wt" "$filters_explicit" "${test_filters[@]}"
else
  state="$state_root/$resume.json"
  [ -f "$state" ] || { echo "没有该 SHA 的接续记录：$resume" >&2; exit 1; }
fi
result="$(node "$state_tool" field "$state" source)"
base="$(node "$state_tool" field "$state" base)"
previous="$(node "$state_tool" field "$state" previous)"
wt="$(node "$state_tool" field "$state" worktree)"
test_filters=()
while IFS= read -r filter; do
  [ -z "$filter" ] || test_filters+=("$filter")
done < <(node "$state_tool" field "$state" filters)
iso="$wt/scripts/run-resource-isolated"
printf '固定输入：base=%s source=%s previous=%s\n接续命令：%s --resume %s\n' "$base" "$result" "$previous" "$0" "$result"

step "安装依赖"
run_stage install "$iso" --profile package -- pnpm -C "$wt" install --frozen-lockfile

step "维护脚本与边界契约"
run_stage maintenance "$iso" --profile package -- node --test "$wt/scripts/fork-maintenance.test.mjs"
run_stage protocol "$iso" --profile package -- pnpm -C "$wt" exec turbo run test --filter=@bb/host-daemon-contract --concurrency=1 --output-logs=errors-only
run_stage plugin-contract "$iso" --profile package -- pnpm -C "$wt" exec turbo run test --filter=@bb/server --concurrency=1 --output-logs=errors-only -- test/services/plugins/plugin-authoring-docs.test.ts

step "全仓 typecheck"
run_stage typecheck "$iso" --profile package -- pnpm -C "$wt" exec turbo run typecheck --concurrency=1 --continue --output-logs=errors-only

step "测试"
filter_args=()
for f in "${test_filters[@]}"; do filter_args+=("--filter=$f"); done
run_stage tests "$iso" --profile package -- pnpm -C "$wt" exec turbo run test --concurrency=1 --continue --output-logs=errors-only "${filter_args[@]}"

if [ "$verify_only" = 1 ]; then
  step "仅验证，停止"
  printf '聚合 SHA：%s\n部署检出：%s\n上次 main：%s\n' "$result" "$wt" "$previous"
  exit 0
fi

step "提升 main"
if [ "$result" = "$previous" ]; then
  echo "fork/main 已经是 $result"
else
  "$here/fork-aggregate" --base "$base" --promote-only --result "$result"
fi
[ "$(git ls-remote fork refs/heads/main | cut -f1)" = "$result" ]

if [ "$build" = 1 ]; then
  config="$root/config/local-aggregate-web.json"
  [ -f "$config" ] || { echo "缺少 $config，无法构建部署检出" >&2; exit 1; }
  node_exe="$(config_value nodeExecutable)"
  step "运行时构建（$node_exe）"
  "$iso" --profile package -- "$node_exe" "$wt/.bb/skills/local-aggregate-deploy/scripts/build-runtime.mjs" --repo "$wt"
  "$node_exe" "$wt/scripts/ensure-native-modules.mjs" --check
fi

if [ "$release" = 1 ]; then
  step "发布 tag"
  version="${base#desktop-v}"
  tag="$(git tag --points-at "$result" 'fork-v*' | head -1)"
  if [ -z "$tag" ]; then
    tag="$(git ls-remote fork 'refs/tags/fork-v*^{}' | awk -v sha="$result" '$1 == sha { sub(/\^\{\}$/, "", $2); sub(/^refs\/tags\//, "", $2); print $2 }' | head -1)"
  fi
  if [ -n "$tag" ]; then
    echo "复用已有 tag $tag"
  else
    day="$(date -u +%Y%m%d)"
    n=1
    while git rev-parse --verify --quiet "refs/tags/fork-v$version-$day.$n" >/dev/null \
      || [ -n "$(git ls-remote fork "refs/tags/fork-v$version-$day.$n")" ]; do
      n=$((n + 1))
    done
    tag="fork-v$version-$day.$n"
    git tag -a "$tag" "$result" -m "BB fork aggregate $(date -u +%Y-%m-%d)"
    git push fork "refs/tags/$tag"
  fi
  remote_tag="$(git ls-remote fork "refs/tags/$tag^{}" | cut -f1)"
  [ "$remote_tag" = "$result" ] || { echo "远端 tag $tag 指向 $remote_tag，不是 $result" >&2; exit 1; }
  echo "tag $tag -> $result；流水线：https://github.com/hxy91819/bb/actions/workflows/fork-release.yml"
fi

step "清理被取代的候选"
service_dir=""
if [ -f "${config:-}" ]; then
  service_dir="$(systemctl show "$(config_value systemdUnit)" -p WorkingDirectory --value 2>/dev/null || true)"
fi
for dir in "$root"/.worktrees/aggregate-deploy-*; do
  [ -d "$dir" ] || continue
  [ "$dir" = "$wt" ] && continue
  [ "$dir" = "$service_dir" ] && continue
  sha="$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)"
  [ "$sha" = "$previous" ] && continue
  if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    echo "保留 $dir：有未提交改动"
    continue
  fi
  git worktree remove "$dir" && echo "已删除 $dir"
done

step "完成"
cat <<EOF
聚合 SHA：$result
部署检出：$wt
上次 main：$previous
EOF
if [ "$build" = 1 ]; then
  unit="$(config_value systemdUnit)"
  old_dir="$(systemctl show "$unit" -p WorkingDirectory --value 2>/dev/null || true)"
  old_start="$(systemctl show "$unit" -p ExecStart --value 2>/dev/null || true)"
  target="$wt"
  if [[ "$old_start" == *"/bin/bb-app"* ]]; then
    if [ "$release" != 1 ]; then
      echo "当前服务使用安装包；本次未发布 Release，不生成源码切换命令。"
      exit 0
    fi
    target="$(dirname "$old_dir")/bb-$tag-$(node -p 'process.platform + "-" + process.arch')"
    echo "当前服务使用安装包：先下载、校验并解压 $tag 的平台包到 $target，再生成切换计划。"
  fi
  cat <<EOF

生成只读 cutover/回退计划（当前服务目录：${old_dir:-未知}）：
  node "$wt/scripts/fork-cutover.mjs" "$config" "$target" "$result"
计划根据实际 unit 校验并同时更新 ExecStart 与 WorkingDirectory。允许从 BB 线程内发起：
先用 upgrade-resume 记录恢复批次，再按部署 skill 将完整切换、验证和回退交给独立 systemd 任务。
执行任务须位于 $unit 的 cgroup 之外；恢复后核对任务结果、双端口健康和实际版本。
EOF
fi
