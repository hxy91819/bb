#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' 'Usage:'
  printf '%s\n' '  scripts/run-resource-isolated [--profile verification|package] -- <command> [args...]'
  printf '%s\n' '  scripts/run-resource-isolated --status'
}

unit_name='bb-local-verification'
profile='verification'

user_manager_env() {
  local uid runtime_dir bus
  uid="$(id -u)"
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${runtime_dir}/bus}"
  [[ -S "${runtime_dir}/bus" ]] || {
    printf 'User systemd bus is unavailable at %s\n' "${runtime_dir}/bus" >&2
    exit 1
  }
  export XDG_RUNTIME_DIR="${runtime_dir}"
  export DBUS_SESSION_BUS_ADDRESS="${bus}"
}

current_cgroup() {
  awk -F: '$1 == "0" {print $3}' /proc/self/cgroup
}

release_idle_scope() {
  local load_state active_state control_group populated attempts
  attempts=0
  while (( attempts < 40 )); do
    load_state="$(systemctl --user show "${unit_name}.scope" -p LoadState --value)"
    [[ "${load_state}" == 'not-found' ]] && return 0
    [[ "${load_state}" == 'loaded' ]] || { printf 'Unknown resource unit state; preserving existing ownership\n' >&2; exit 1; }
    active_state="$(systemctl --user show "${unit_name}.scope" -p ActiveState --value)"
    control_group="$(systemctl --user show "${unit_name}.scope" -p ControlGroup --value)"
    if [[ -n "${control_group}" ]]; then
      [[ -r "/sys/fs/cgroup${control_group}/cgroup.events" ]] || { printf 'Resource cgroup metadata is unavailable; preserving existing ownership\n' >&2; exit 1; }
      populated="$(awk '$1 == "populated" {print $2}' "/sys/fs/cgroup${control_group}/cgroup.events")"
      case "${populated}" in
        1) printf 'Another %s job is still running; wait for its complete cgroup to exit\n' "${unit_name}" >&2; exit 1 ;;
        0) ;;
        *) printf 'Resource cgroup populated state is unavailable; preserving existing ownership\n' >&2; exit 1 ;;
      esac
    elif [[ "${active_state}" != 'inactive' && "${active_state}" != 'failed' ]]; then
      printf 'Resource unit has no verifiable cgroup; preserving existing ownership\n' >&2
      exit 1
    fi
    if [[ "${active_state}" == 'failed' ]]; then
      systemctl --user reset-failed "${unit_name}.scope"
    fi
    attempts=$((attempts + 1))
    sleep 0.05
  done
  printf 'Empty %s.scope has not been collected; retry after systemd completes its cleanup\n' "${unit_name}" >&2
  exit 1
}

if [[ "${1:-}" == '--help' || "${1:-}" == '-h' ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == '--status' ]]; then
  user_manager_env
  exec systemctl --user show "${unit_name}.scope" \
    -p ActiveState \
    -p ControlGroup \
    -p CPUQuotaPerSecUSec \
    -p MemoryHigh \
    -p MemoryMax \
    -p MemorySwapMax \
    -p LoadState \
    -p OOMPolicy \
    -p TasksMax
fi

if [[ "${1:-}" == '--profile' ]]; then
  if (( $# < 2 )); then
    usage >&2
    exit 2
  fi
  profile="${2:-}"
  shift 2
fi

if [[ "${1:-}" == '--' ]]; then
  shift
fi

case "${profile}" in
  verification|package) ;;
  *) printf 'Unknown resource profile: %s\n' "${profile}" >&2; exit 2 ;;
esac

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
budget_tool="${here}/resource-runtime.mjs"
export BB_RESOURCE_BUDGET="$(node "${budget_tool}" select "${profile}")"
[[ -n "${BB_RESOURCE_BUDGET}" ]] || exit 1
fields="$(node "${budget_tool}" fields "${profile}")"
read -r memory_high memory_max cpu_quota workers tasks_max vitest_workers <<< "${fields}"
export BB_RESOURCE_VITEST_WORKERS="${workers}"
export VITEST_MAX_WORKERS="${vitest_workers}"

if (( $# == 0 )); then
  usage >&2
  exit 2
fi

cgroup="$(current_cgroup)"
case "${cgroup}" in
  */"${unit_name}.scope"|*/"${unit_name}.scope"/*)
    scope_group="${cgroup%%/${unit_name}.scope*}/${unit_name}.scope"
    node "${budget_tool}" verify "${profile}" "${scope_group}"
    exec "$@"
    ;;
esac

command -v systemd-run >/dev/null 2>&1 || {
  printf '%s\n' 'systemd-run is required for resource-isolated execution' >&2
  exit 1
}

user_manager_env
release_idle_scope

export TURBO_CACHE_DIR="${TURBO_CACHE_DIR:-${HOME}/.cache/bb-turbo}"

slice_args=()
if [[ -n "${BB_FORK_CGROUP_PLAN:-}" ]]; then
  slice_args=(--slice-inherit)
fi

exec systemd-run --user --scope --collect --quiet "${slice_args[@]}" \
  --unit="${unit_name}" \
  --description='BB local verification resource boundary' \
  --nice=5 \
  -p "MemoryHigh=${memory_high}" \
  -p "MemoryMax=${memory_max}" \
  -p MemorySwapMax=0 \
  -p "CPUQuota=${cpu_quota}%" \
  -p "TasksMax=${tasks_max}" \
  env BB_RESOURCE_SCOPE_ACTIVE=1 \
  bash -c 'systemctl --user set-property --runtime "$1.scope" "MemoryHigh=$2" MemorySwapMax=0 || exit; shift 2; tool="$1"; profile="$2"; shift 2; group="$(awk -F: '"'"'$1 == "0" {print $3}'"'"' /proc/self/cgroup)"; node "$tool" verify "$profile" "$group" || exit; exec "$@"' \
  bash "${unit_name}" "${memory_high}" "${budget_tool}" "${profile}" "$@"
